{
  "name": "Trusted App only protected updates",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    {
      "actor_id": 5210232,
      "actor_type": "Integration",
      "bypass_mode": "pull_request"
    }
  ],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main",
        "refs/heads/develop",
        "refs/heads/release/*",
        "refs/heads/hotfix/*"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "update"
    }
  ]
}
